          <site name="FR_foot_site" pos="0 0 -0.08" size="0.011" type="sphere" rgba="0 0 0 0"/>
        </body>
      </body>
    </body>
    <body name="MR_coxa" pos="0 -0.085 0" quat="0.70711 0 0 -0.70711">
      <joint name="MR_hip" class="hip"/>
      <geom name="MR_coxa_g" type="box" size="0.025 0.012 0.017"
            pos="0.025 0 0" mass="0.08" class="link"/>
      <body name="MR_femur" pos="0.05 0 0">
        <joint name="MR_femur" class="pitch" range="-60.0 60.0"/>
        <geom name="MR_femur_g" type="capsule" fromto="0 0 0 0.075 0 0"
