        </body>
      </body>
    </body>
    </body>
  </worldbody>

  <actuator>
    <position name="FL_hip" joint="FL_hip" class="servo"/>
    <position name="FL_femur" joint="FL_femur" class="servo"/>
    <position name="FL_tibia" joint="FL_tibia" class="servo"/>
    <position name="ML_hip" joint="ML_hip" class="servo"/>
    <position name="ML_femur" joint="ML_femur" class="servo"/>
    <position name="ML_tibia" joint="ML_tibia" class="servo"/>
