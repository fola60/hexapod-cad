<mujoco model="crab_hexapod">
  <!-- Generated by gen_crab.py. Edit the numbers there, not here. -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <joint damping="0.3" armature="0.005" frictionloss="0.03"/>
    <!-- robot geoms collide with the floor only, not with each other (turn on later) -->
    <geom contype="2" conaffinity="1" friction="1.0 0.02 0.001"/>
    <default class="hip">
      <joint axis="0 0 1" range="-30.0 30.0"/>
    </default>
    <default class="pitch">
      <!-- +angle lifts the link up -->
      <joint axis="0 -1 0"/>
    </default>
    <default class="link"><geom rgba="0.2 0.2 0.22 1"/></default>
    <default class="foot"><geom rgba="0.05 0.05 0.05 1" condim="3"/></default>
    <default class="servo">
      <position kp="10.0" forcerange="-2.9 2.9"/>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".85 .85 .85" rgb2=".75 .75 .75" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid" contype="1" conaffinity="2"/>

    <body name="base_link" pos="0 0 0.0920">
      <freejoint name="root"/>
      <geom name="body_g" type="box" size="0.14 0.1 0.0225"
            mass="1.060" rgba="0.15 0.15 0.15 1"/>
      <site name="imu" pos="0 0 0" size="0.005"/>

    <body name="FL_coxa" pos="0.12 0.085 0" quat="0.92388 0 0 0.38268">
      <joint name="FL_hip" class="hip"/>
      <geom name="FL_coxa_g" type="box" size="0.025 0.012 0.017"
            pos="0.025 0 0" mass="0.08" class="link"/>
      <body name="FL_femur" pos="0.05 0 0">
        <joint name="FL_femur" class="pitch" range="-60.0 60.0"/>
        <geom name="FL_femur_g" type="capsule" fromto="0 0 0 0.075 0 0"
              size="0.012" mass="0.09" class="link"/>
        <body name="FL_tibia" pos="0.075 0 0">
          <joint name="FL_tibia" class="pitch" range="-60.0 60.0"/>
          <geom name="FL_tibia_g" type="capsule" fromto="0 0 0 0 0 -0.08"
                size="0.008" mass="0.03" class="link"/>
          <geom name="FL_foot" type="sphere" pos="0 0 -0.08"
                size="0.01" mass="0.005" class="foot"/>
          <site name="FL_foot_site" pos="0 0 -0.08" size="0.011" type="sphere" rgba="0 0 0 0"/>
        </body>
      </body>
    </body>
    <body name="ML_coxa" pos="0 0.085 0" quat="0.70711 0 0 0.70711">
      <joint name="ML_hip" class="hip"/>
      <geom name="ML_coxa_g" type="box" size="0.025 0.012 0.017"
            pos="0.025 0 0" mass="0.08" class="link"/>
      <body name="ML_femur" pos="0.05 0 0">
        <joint name="ML_femur" class="pitch" range="-60.0 60.0"/>
        <geom name="ML_femur_g" type="capsule" fromto="0 0 0 0.075 0 0"
              size="0.012" mass="0.09" class="link"/>
        <body name="ML_tibia" pos="0.075 0 0">
